# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# node runtime binaries (e.g. worker/功能整合web/.node/)
**/.node/
node_modules/

# typescript incremental build cache
*.tsbuildinfo

# embedded worker project (4GB, has own .git; preview built into public/hmi-agent)
worker/功能整合web/

# 作品集原图(PNG)不部署,只用 WebP;磁盘保留 PNG 供本地备用
public/works/**/*.png
